{
  "name": "crewlyze",
  "version": "1.2.3",
  "description": "Autonomous Multi-Agent Business Intelligence and Data Engineering Platform",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sowmiyan-s/crewlyze.git"
  },
  "bin": {
    "crewlyze": "bin/crewlyze.js"
  },
  "preferGlobal": true,
  "files": [
    "bin/",
    "agents/",
    "assets/",
    "config/",
    "data/",
    "tools/",
    "ui/",
    "web/",
    "workflows/",
    "main.py",
    "crew.py",
    "index.js",
    "requirements.txt",
    "pyproject.toml",
    "LICENSE",
    "README.md",
    "README-NPM.md",
    "!**/__pycache__/**",
    "!**/*.pyc",
    "!**/*.pyo"
  ],
  "scripts": {
    "test": "pytest tests/ -v",
    "start": "node ./bin/crewlyze.js",
    "postinstall": "node ./bin/install-python.js",
    "install-python": "node ./bin/install-python.js",
    "prepack": "node ./bin/prepack.js",
    "postpack": "node ./bin/postpack.js",
    "build:installer": "installer\\build_installer.bat"
  },
  "keywords": [
    "ai",
    "data-analysis",
    "crewai",
    "fastapi",
    "python"
  ],
  "author": "Sowmiyan S",
  "license": "MIT"
}
